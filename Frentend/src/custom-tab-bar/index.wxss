.tabbar,
.halo,
.bar,
.item,
.shutter,
.bezel,
.core {
  box-sizing: border-box;
}

.tabbar {
  position: relative;
  overflow: visible;
  background-color: transparent;
}

.halo {
  position: absolute;
  left: 50%;
  top: -76rpx;
  z-index: 1;
  width: 152rpx;
  height: 152rpx;
  margin-left: -76rpx;
  border-radius: 50%;
  background-color: #121c17;
  border: 1px solid rgba(212, 163, 89, 0.55);
  pointer-events: none;
}

.bar {
  position: relative;
  z-index: 2;
  box-sizing: content-box;
  height: 96rpx;
  display: flex;
  align-items: flex-start;
  padding: 0 4rpx 16px;
  background-color: #121c17;
}

.rail-left,
.rail-right {
  position: absolute;
  top: 0;
  height: 1px;
  background: rgba(212, 163, 89, 0.55);
}

.rail-left {
  left: 0;
  right: 50%;
  margin-right: 76rpx;
}

.rail-right {
  left: 50%;
  right: 0;
  margin-left: 76rpx;
}

.is-hidden {
  display: none;
}

.item {
  flex: 1;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 18rpx;
  color: #8ba895;
  min-width: 0;
}

.active {
  color: #d4a359;
}

.glyph {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
}

.glyph-camp {
  font-size: 36rpx;
}

.glyph-codex {
  font-size: 30rpx;
}

.glyph-rank {
  font-size: 30rpx;
}

.glyph-me {
  font-size: 30rpx;
}

.label {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  letter-spacing: 1rpx;
}

.slot {
  width: 152rpx;
  flex-shrink: 0;
  height: 96rpx;
}

.shutter {
  position: absolute;
  left: 50%;
  top: -68rpx;
  z-index: 3;
  width: 136rpx;
  height: 136rpx;
  margin-left: -68rpx;
  border-radius: 50%;
  padding: 8rpx;
  background: linear-gradient(160deg, #f0d5a0 0%, #d4a359 42%, #8a5a28 100%);
  box-shadow:
    0 12rpx 28rpx rgba(0, 0, 0, 0.5),
    0 0 24rpx rgba(212, 163, 89, 0.32),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.38);
}

.bezel {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
  background: radial-gradient(circle at 50% 38%, #3a5246 0%, #15201b 72%);
  border: 2rpx solid rgba(62, 40, 16, 0.4);
}

.tick {
  position: absolute;
  background: #d4a359;
}

.n,
.s {
  width: 2rpx;
  height: 12rpx;
  left: 50%;
  margin-left: -1rpx;
}

.e,
.w {
  width: 12rpx;
  height: 2rpx;
  top: 50%;
  margin-top: -1rpx;
}

.n {
  top: 6rpx;
}

.s {
  bottom: 6rpx;
}

.e {
  right: 6rpx;
}

.w {
  left: 6rpx;
}

.core {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f0d5a0 0%, #d4a359 52%, #8a5a28 100%);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.38),
    0 6rpx 12rpx rgba(0, 0, 0, 0.4);
}

.mark {
  color: #2b2823;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
  margin-top: -4rpx;
}
