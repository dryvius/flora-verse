# 本地开发示例。复制为 .env 后使用，不要把真实 .env 提交到 Git。
# 生产环境必须更换全部密钥，并通过密钥管理注入。

NODE_ENV=development
PORT=3000

# 与 compose.yaml 中的本地 MySQL 账号一致，仅用于本机开发。
DATABASE_URL="mysql://app:app_password@localhost:3306/floraverse"

# 至少 32 位。生产环境禁止继续使用包含 change-before-production 的占位值。
JWT_ACCESS_SECRET=local-dev-access-secret-change-before-production
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-before-production

WECHAT_APP_ID=
WECHAT_APP_SECRET=

STORAGE_PROVIDER=local
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

PLANT_RECOGNITION_PROVIDER=mock
PLANT_RECOGNITION_API_KEY=

IMAGE_GENERATION_PROVIDER=mock
IMAGE_GENERATION_API_KEY=

# 生产环境默认关闭 Swagger。需要临时打开时设为 true。
# SWAGGER_ENABLED=false

# 仅浏览器调试时需要。微信小程序不依赖 CORS。
# CORS_ORIGIN=http://localhost:5173
